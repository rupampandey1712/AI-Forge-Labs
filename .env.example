# ─────────────────────────────────────────────────────────────
# AI FORGE LABS — environment configuration
# Copy to .env and adjust. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

APP_ENV=development              # development | test | production
APP_DEBUG=true
APP_NAME="AI Forge Labs"
API_V1_PREFIX=/api/v1

# --- Security -------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database -------------------------------------------------
# Docker Compose default. For bare-metal local dev without Postgres,
# leave DATABASE_URL unset and the app falls back to SQLite (aiosqlite).
DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/aiforge
# DATABASE_URL=sqlite+aiosqlite:///./aiforge.db

# --- Redis ----------------------------------------------------
# Optional. If unset/unreachable the app degrades to an in-process cache.
REDIS_URL=redis://localhost:6379/0

# --- CORS -----------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Code execution sandbox -----------------------------------
SANDBOX_MODE=subprocess          # subprocess | docker | disabled
SANDBOX_TIMEOUT_SECONDS=8
SANDBOX_MEMORY_MB=256
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_DOCKER_IMAGE=aiforge-sandbox:latest

# --- LLM (optional; the game runs fully offline without these) -
# "mock" gives deterministic simulated responses so every AI lab is playable
# with no key. Set a provider + its key to use real models.
LLM_PROVIDER=mock                # mock | gemini | anthropic | openai
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Leave blank to use the provider default
# (gemini-2.5-flash / claude-sonnet-5 / gpt-4o-mini).
LLM_MODEL=
LLM_MAX_TOKENS=2048

# --- Logging --------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
